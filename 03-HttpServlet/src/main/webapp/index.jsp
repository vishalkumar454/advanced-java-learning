<html>
<body>
	
	<h2>Enter your Credential</h2>
	
	<form action="/03-HttpServlet/data" method="post">
		<fieldset>
			<legend>User data</legend>
			
			<label for="username">Name : </label>
			<input type="text" placeholder="Enter your name" id="username" name="username">
			<br><br>
			
			<label for="email">Email : </label>
			<input type="text" placeholder="Enter your email" id="email" name="email">
			<br><br>
			
			<label for="password">Password : </label>
			<input type="text" placeholder="Enter your password" id="password" name="password">
			<br><br>
			
			<button>Submit</button>
			
		</fieldset>
	</form>
</body>
</html>
