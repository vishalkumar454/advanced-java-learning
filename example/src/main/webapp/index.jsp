<html>
<body>

<h2>Enter your Credential</h2>
	
	<form action="/example/data" method="post">
		<fieldset>
			<legend>User data</legend>
			
			<label for="firstInt">firstInt : </label>
			<input type="number" placeholder="Enter your firstInt no" id="firstInt" name="firstInt">
			<br><br>
			
			<label for="secondInt">secondInt : </label>
			<input type="number" placeholder="Enter your secondInt no" id="secondInt" name="secondInt">
			<br><br>
			
			<label for="thirdInt">thirdInt : </label>
			<input type="number" placeholder="Enter your thirdInt no" id="thirdInt" name="thirdInt">
			<br><br>
			
			<label for="string">string data : </label>
			<input type="text" placeholder="Enter your string" id="string" name="string">
			<br><br>
			
			<label for="decimal">decimal data : </label>
			<input type="text" placeholder="Enter your decimal no" id="decimal" name="decimal">
			<br><br>
			
			<button>Submit</button>
			
		</fieldset>
	</form>
</body>
</html>
